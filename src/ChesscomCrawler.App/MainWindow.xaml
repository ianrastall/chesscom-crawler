<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Jupiter.ChesscomCrawler.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Jupiter.ChesscomCrawler.App.Views"
    Title="Chess.com Crawler">

    <Grid x:Name="Root" Background="{ThemeResource JupiterWindowBrush}" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <SelectorBar x:Name="Pages" Margin="16,8,16,0" SelectionChanged="OnPageChanged">
            <SelectorBarItem x:Name="StatusItem" Text="Status" IsSelected="True" AutomationProperties.AutomationId="StatusTab" />
            <SelectorBarItem x:Name="SettingsItem" Text="Settings" AutomationProperties.AutomationId="SettingsTab" />
        </SelectorBar>

        <views:StatusView x:Name="StatusPage" Grid.Row="1" />
        <views:SettingsView x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" />
    </Grid>
</Window>
