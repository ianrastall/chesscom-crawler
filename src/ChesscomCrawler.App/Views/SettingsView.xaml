<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jupiter.ChesscomCrawler.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Jupiter.ChesscomCrawler.App.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar Margin="24,16,24,0"
                 IsOpen="{x:Bind ViewModel.MessageOpen, Mode=TwoWay}"
                 Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
                 Title="{x:Bind ViewModel.MessageTitle, Mode=OneWay}"
                 Message="{x:Bind ViewModel.MessageText, Mode=OneWay}" />

        <ScrollViewer Grid.Row="1" Padding="24,0,24,24">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="12">

                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Collections" />
                <RadioButtons Header="Ratings and names" SelectedIndex="{x:Bind ViewModel.RatingSourceIndex, Mode=TwoWay}">
                    <x:String>Chess.com usernames and Chess.com ratings</x:String>
                    <x:String>FIDE real names and FIDE standard ratings</x:String>
                </RadioButtons>
                <TextBlock Style="{StaticResource ExplanationStyle}" Margin="0,-6,0,0"
                           Text="FIDE names and ratings require identifying both players: each account's profile name and title are matched to one player on the newest FIDE list, at one profile request per account. Games whose players cannot be identified, including bot accounts, are left out, so this collection is much smaller." />
                <TextBox Header="Rating floors" Text="{x:Bind ViewModel.Floors, Mode=TwoWay}" Width="320" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource ExplanationStyle}" Margin="0,-6,0,0"
                           Text="Both players' ratings must meet a floor: the Chess.com ratings recorded with the game, or FIDE standard ratings from the month's list. Each floor writes its own collection, for example 2400, 2700." />

                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Games" />
                <TextBlock Text="Time controls" />
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <CheckBox Content="Bullet" IsChecked="{x:Bind ViewModel.Bullet, Mode=TwoWay}" />
                    <CheckBox Content="Blitz" IsChecked="{x:Bind ViewModel.Blitz, Mode=TwoWay}" />
                    <CheckBox Content="Rapid" IsChecked="{x:Bind ViewModel.Rapid, Mode=TwoWay}" />
                    <CheckBox Content="Daily" IsChecked="{x:Bind ViewModel.Daily, Mode=TwoWay}" />
                </StackPanel>
                <CheckBox Content="Standard chess only (no variants or custom starting positions)" IsChecked="{x:Bind ViewModel.StandardOnly, Mode=TwoWay}" />
                <CheckBox Content="Rated games only" IsChecked="{x:Bind ViewModel.RatedOnly, Mode=TwoWay}" />
                <CheckBox Content="Only games ending in checkmate" IsChecked="{x:Bind ViewModel.CheckmateOnly, Mode=TwoWay}" />
                <CheckBox Content="Exclude accounts closed for fair-play violations" IsChecked="{x:Bind ViewModel.ExcludeFairPlay, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource ExplanationStyle}"
                           Text="The fair-play check reads each player's profile once (one request per account, cached)." />

                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Months" />
                <RadioButtons Header="Months to crawl" SelectedIndex="{x:Bind ViewModel.MonthModeIndex, Mode=TwoWay}" MaxColumns="2">
                    <x:String>Continuous</x:String>
                    <x:String>Specific months</x:String>
                </RadioButtons>
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsContinuous, Mode=OneWay}">
                    <CheckBox Content="Start from the previous month" IsChecked="{x:Bind ViewModel.StartFromPreviousMonth, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBox Header="Start month" PlaceholderText="YYYY-MM" Width="160"
                                 Text="{x:Bind ViewModel.StartMonth, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.StartMonthEnabled, Mode=OneWay}" />
                        <ComboBox Header="Direction" Width="220" SelectedIndex="{x:Bind ViewModel.DirectionIndex, Mode=TwoWay}">
                            <x:String>Backward (older months)</x:String>
                            <x:String>Forward (newer months)</x:String>
                        </ComboBox>
                        <TextBox Header="Stop at (optional)" PlaceholderText="YYYY-MM" Width="160" Text="{x:Bind ViewModel.StopMonth, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
                <TextBox Header="Months" PlaceholderText="2026-01..2026-06, 2025-11" Text="{x:Bind ViewModel.SpecificMonths, Mode=TwoWay}"
                         Visibility="{x:Bind ViewModel.IsSpecific, Mode=OneWay}" />
                <TextBlock Style="{StaticResource ExplanationStyle}" Margin="0,-6,0,0"
                           Text="Months and ranges, separated by commas. Ranges run in the order written." />
                <CheckBox Content="Afterwards, collect each new month once it completes" IsChecked="{x:Bind ViewModel.FollowNewMonths, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource ExplanationStyle}"
                           Text="Only complete months are crawled. A month is finished once every eligible account's archive has been read; finished months are not requested again." />

                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Players" />
                <TextBlock Text="Chess.com title lists to crawl" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.TitleOptions}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="88" MinColumnSpacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:TitleOption">
                            <CheckBox Content="{x:Bind Title}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <TextBlock Style="{StaticResource ExplanationStyle}"
                           Text="With FIDE ratings, each seed account's profile is requested once and refreshed every few months, so the first run takes several hours. With Chess.com ratings, discovered opponents cost no extra requests." />
                <TextBox Header="Additional accounts" PlaceholderText="Chess.com usernames, separated by commas" Text="{x:Bind ViewModel.ExtraAccounts, Mode=TwoWay}" />
                <CheckBox Content="Add opponents who meet the floor to the crawl" IsChecked="{x:Bind ViewModel.DiscoverOpponents, Mode=TwoWay}" />
                <CheckBox Content="Identify accounts that are not on any title list" IsChecked="{x:Bind ViewModel.IncludeUntitled, Mode=TwoWay}"
                          IsEnabled="{x:Bind ViewModel.IsFide, Mode=OneWay}" />
                <TextBlock Style="{StaticResource ExplanationStyle}"
                           Text="With FIDE ratings: untitled accounts cost one profile request each and can only match FIDE players without a title. A titled account must match a FIDE player holding the same title." />
                <NumberBox Header="Skip unknown opponents rated this far below the floor on Chess.com" Width="420" HorizontalAlignment="Left"
                           Minimum="0" Maximum="3000" SmallChange="50" LargeChange="100" SpinButtonPlacementMode="Inline"
                           Value="{x:Bind ViewModel.PrefilterMargin, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.IsFide, Mode=OneWay}" />
                <TextBlock Style="{StaticResource ExplanationStyle}" Margin="0,-6,0,0"
                           Text="With FIDE ratings: saves profile requests for opponents who cannot plausibly meet the floor. 0 turns this off." />

                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="FIDE database" />
                <TextBox Header="Folders (one per line)" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="72"
                         Text="{x:Bind ViewModel.FideFolders, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource ExplanationStyle}" Margin="0,-6,0,0"
                           Text="Used only for identification. Yearly (fide-YYYY.sqlite) and per-list (fide-standard-YYYY-MM.sqlite) databases are both read. Each game uses the newest standard list published in or before its month." />
                <NumberBox Header="Oldest usable list, in months before the game" Width="320" HorizontalAlignment="Left"
                           Minimum="0" Maximum="24" SmallChange="1" SpinButtonPlacementMode="Inline"
                           Value="{x:Bind ViewModel.MaxFideListAge, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource ExplanationStyle}" Margin="0,-6,0,0"
                           Text="Months without a recent enough list are skipped until one is added." />

                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Server usage" />
                <NumberBox Header="Seconds between requests" Width="240" HorizontalAlignment="Left"
                           Minimum="1" Maximum="3600" SmallChange="0.5" LargeChange="1" SpinButtonPlacementMode="Inline"
                           Value="{x:Bind ViewModel.RequestInterval, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource ExplanationStyle}" Margin="0,-6,0,0"
                           Text="Requests are always made one at a time. After a rate-limit or server error the crawler waits from one minute up to 30 minutes, honouring Retry-After." />
                <TextBox Header="Contact for Chess.com (optional)" PlaceholderText="Email address or website" Text="{x:Bind ViewModel.Contact, Mode=TwoWay}" />
                <TextBlock Style="{StaticResource ExplanationStyle}" Margin="0,-6,0,0"
                           Text="Sent in the User-Agent header so Chess.com can reach you about this traffic. Leave empty to send none." />

                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Output" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Header="Output folder" Text="{x:Bind ViewModel.OutputFolder, Mode=TwoWay}" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse…" Click="OnBrowseOutput" />
                </Grid>
                <TextBlock Style="{StaticResource ExplanationStyle}" Margin="0,-6,0,0"
                           Text="Files are written as chesscom-2400\chesscom-2400-2026-09.pgn inside this folder, or chesscom-fide-2400\… with FIDE ratings." />
                <CheckBox Content="Remove clock comments" IsChecked="{x:Bind ViewModel.RemoveClockComments, Mode=TwoWay}" />

                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Startup" />
                <CheckBox Content="Start crawling when the app opens" IsChecked="{x:Bind ViewModel.StartOnLaunch, Mode=TwoWay}" />
                <ToggleSwitch x:Name="SignInSwitch" Header="Start when I sign in to Windows" Toggled="OnSignInToggled" />
                <TextBlock Style="{StaticResource ExplanationStyle}" Text="Applies immediately. The app opens in the notification area." />

                <TextBlock Style="{StaticResource SectionHeadingStyle}" Text="Appearance" />
                <RadioButtons x:Name="AccentChoice" Header="Accent color" SelectionChanged="OnAccentChoiceChanged">
                    <x:String>Use Windows accent color</x:String>
                    <x:String>Custom color</x:String>
                </RadioButtons>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="AccentSwatchButton" AutomationProperties.Name="Choose custom accent color" ToolTipService.ToolTip="Choose custom accent color">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border x:Name="AccentSwatch" Width="20" Height="20" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource JupiterSeparatorBrush}" />
                            <TextBlock Text="Choose color" />
                        </StackPanel>
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Spacing="12">
                                    <ColorPicker x:Name="AccentPicker" IsAlphaEnabled="False" IsMoreButtonVisible="True" />
                                    <Button HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Content="Apply" Click="OnApplyCustomAccent" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="Reset to Windows accent" Click="OnResetAccent" />
                </StackPanel>
                <TextBlock Style="{StaticResource ExplanationStyle}" Text="Applies immediately and is kept for this app only." />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{ThemeResource JupiterSeparatorBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Style="{StaticResource AccentButtonStyle}" Content="Save" Command="{x:Bind ViewModel.SaveCommand}"
                        ToolTipService.ToolTip="Save the crawl settings. A running crawl restarts with them." />
                <Button Content="Revert" Command="{x:Bind ViewModel.RevertCommand}" ToolTipService.ToolTip="Discard unsaved changes" />
                <Button Content="Rewrite collections" Command="{x:Bind ViewModel.RewriteCollectionsCommand}"
                        ToolTipService.ToolTip="Write every month's PGN files again from collected games, using the saved floors and filters" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
