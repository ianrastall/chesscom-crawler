<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Jupiter.ChesscomCrawler.App.Views.StatusView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Jupiter.ChesscomCrawler.App.ViewModels">

    <Grid Padding="24,16,24,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageHeadingStyle}" Text="{x:Bind ViewModel.StateText, Mode=OneWay}" />
                <TextBlock Foreground="{ThemeResource JupiterSecondaryTextBrush}" Text="{x:Bind ViewModel.PhaseText, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}"
                    AutomationProperties.Name="Start" AutomationProperties.AutomationId="StartButton"
                    Command="{x:Bind ViewModel.StartCommand}" ToolTipService.ToolTip="Start or resume the crawl. Progress from earlier runs is kept.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE768;" />
                    <TextBlock Text="Start" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" VerticalAlignment="Center"
                    AutomationProperties.Name="Stop" AutomationProperties.AutomationId="StopButton"
                    Command="{x:Bind ViewModel.StopCommand}" ToolTipService.ToolTip="Stop after the current request. Progress is kept.">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE71A;" />
                    <TextBlock Text="Stop" />
                </StackPanel>
            </Button>
        </Grid>

        <InfoBar Grid.Row="1" IsClosable="False"
                 IsOpen="{x:Bind ViewModel.NoticeOpen, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                 Title="{x:Bind ViewModel.NoticeTitle, Mode=OneWay}"
                 Message="{x:Bind ViewModel.NoticeMessage, Mode=OneWay}" />

        <Border Grid.Row="2" Style="{StaticResource SurfaceStyle}">
            <Grid ColumnSpacing="16" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="Month" />
                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.MonthText, Mode=OneWay}" TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" Style="{StaticResource FieldLabelStyle}" Text="Accounts this month" />
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.AccountsText, Mode=OneWay}" />
                    <ProgressBar Maximum="100" Value="{x:Bind ViewModel.AccountsProgress, Mode=OneWay}"
                                 Visibility="{x:Bind ViewModel.AccountsProgressVisible, Mode=OneWay}"
                                 AutomationProperties.Name="Accounts read this month" />
                </StackPanel>

                <TextBlock Grid.Row="2" Style="{StaticResource FieldLabelStyle}" Text="Games this month" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.MonthGamesText, Mode=OneWay}" />

                <TextBlock Grid.Row="3" Style="{StaticResource FieldLabelStyle}" Text="Games collected" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.TotalGamesText, Mode=OneWay}" />

                <TextBlock Grid.Row="4" Style="{StaticResource FieldLabelStyle}" Text="Identification" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{x:Bind ViewModel.IdentifiedText, Mode=OneWay}" TextWrapping="Wrap" />

                <TextBlock Grid.Row="5" Style="{StaticResource FieldLabelStyle}" Text="Requests this session" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{x:Bind ViewModel.RequestsText, Mode=OneWay}" />

                <TextBlock Grid.Row="6" Style="{StaticResource FieldLabelStyle}" Text="FIDE lists" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{x:Bind ViewModel.FideText, Mode=OneWay}" TextWrapping="Wrap" />

                <TextBlock Grid.Row="7" Style="{StaticResource FieldLabelStyle}" Text="Output folder" VerticalAlignment="Center" />
                <Grid Grid.Row="7" Grid.Column="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.OutputFolder, Mode=OneWay}" TextWrapping="Wrap" />
                    <HyperlinkButton Grid.Column="1" Content="Open folder" Command="{x:Bind ViewModel.OpenOutputFolderCommand}" />
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" Style="{StaticResource SectionHeadingStyle}" Margin="0,8,0,0" Text="Activity" />

        <Border Grid.Row="4" Style="{StaticResource SurfaceStyle}" Padding="4">
            <Grid>
            <TextBlock Margin="12" Style="{StaticResource ExplanationStyle}" FontSize="14" Text="No activity yet."
                       Visibility="{x:Bind ViewModel.ActivityEmpty, Mode=OneWay}" />
            <ListView ItemsSource="{x:Bind ViewModel.Activity}" SelectionMode="None" AutomationProperties.Name="Activity">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActivityItem">
                        <Grid ColumnSpacing="12" Padding="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{ThemeResource JupiterSecondaryTextBrush}" Text="{x:Bind Time}" />
                            <FontIcon Grid.Column="1" FontSize="14" Glyph="{x:Bind Glyph}" Foreground="{ThemeResource JupiterWarningBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Message}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            </Grid>
        </Border>

        <TextBlock Grid.Row="5" Style="{StaticResource ExplanationStyle}"
                   Text="Closing this window keeps the crawler running in the notification area. Choose Exit from its menu to quit." />
    </Grid>
</UserControl>
